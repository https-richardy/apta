@page "/authentication/protocol/connect/"
@layout AuthenticationLayout

@inject IAuthenticationClient AuthenticationClient
@inject JwtBearerAuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation

<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
             VerticalAlignment="VerticalAlignment.Center" VerticalGap="24" Style="height: 100vh; width: 100%;">
    <LoginHeader />
    <div style="width: 360px; max-width: 90%;">
        <LoginForm @bind-Email="_credentials.Email" @bind-Password="_credentials.Password" OnSubmit="HandleSubmit" />
    </div>
</FluentStack>

@code {
    private readonly AuthenticationCredentialsScheme _credentials = new();

    private async Task HandleSubmit()
    {
        var result = await AuthenticationClient.AuthenticateAsync(_credentials);
        if (!result.IsSuccess || result.Data is null)
        {
            return;
        }


        await AuthenticationState.AuthenticateAsync(result.Data.AccessToken);

        Navigation.NavigateTo("/");
    }
}

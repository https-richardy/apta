@switch (State)
{
    case { HasError: true }:
        <FluentLabel Style="color: var(--error, #d13438);">
            Não foi possível carregar as administradoras.
        </FluentLabel>
        break;

    case { CurrentData: { } administrators }:
        <AdministratorsTable Administrators="administrators.Items" />
        break;

    default:
        <Skeleton />
        break;
}

@code {
    [Parameter]
    public QueryState<Pagination<AdministratorScheme>> State { get; set; } = default!;
}

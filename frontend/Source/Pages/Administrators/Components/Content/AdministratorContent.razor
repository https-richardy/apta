@switch (State)
{
    case { HasError: true }:
        <FluentMessageBar Intent="MessageBarIntent.Error">
            Não foi possível carregar as administradoras, se o problema persistir, contate o suporte técnico.
        </FluentMessageBar>
        break;

    case { CurrentData: { } administrators }:
        <AdministratorsTable Administrators="administrators.Items" />
        break;

    default:
        <Skeleton />
        break;
}

@code {
    [Parameter]
    public QueryState<Pagination<AdministratorScheme>> State { get; set; } = default!;
}

@page "/administradoras"

@attribute [Authorize]
@implements IDisposable

@inject AdministratorsService AdministratorsService
@inject IDialogService DialogService

<PageTitle>Instituições Administradoras | Apta™</PageTitle>

<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Style="width: 100%;">
    <div style="width: 960px; max-width: 95%;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Top" Width="100%">
                <Presentation Title="Administradoras" Description="Gerencie aqui as administradoras. As administradoras são as instituições autorizadas pelo BACEN responsáveis por constituir e administrar os grupos de consórcio." />
                <FluentSpacer />
                <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@AddIcon" OnClick="OpenSheetAsync">Adicionar</FluentButton>
            </FluentStack>
            <AdministratorContent State="AdministratorsService.Query.CurrentState" />
        </FluentStack>
    </div>
</FluentStack>

@code {
    private static readonly Icon AddIcon = new Size20.Add();

    private AdministratorFiltersParameters _filters = new();
    private IDisposable? _subscription;

    public void Dispose() => _subscription?.Dispose();
    protected override void OnInitialized()
    {
        _subscription = AdministratorsService.Query.State
            .Subscribe(_ => InvokeAsync(StateHasChanged));

        AdministratorsService.Query
            .SetArgs(_filters);
    }

    private async Task OpenSheetAsync()
    {
        var result = await DialogService.ShowDrawerAsync<AdministratorCreationSheet>(options =>
        {
            options.Data = new AdministratorCreationScheme();
            options.Alignment = DialogAlignment.End;
            options.Width = "420px";
        });

        if (result.Cancelled || result.GetValue<AdministratorCreationScheme>() is not { } model)
        {
            return;
        }

        AdministratorsService.CreateMutation.Execute(model);
    }
}

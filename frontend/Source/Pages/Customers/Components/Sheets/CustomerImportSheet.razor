<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalGap="20" Width="100%" Style="padding: 24px; text-align: center;">
    <div style="font-size: 1.1rem; font-weight: 700;">Importar clientes</div>
    <FluentLabel Size="LabelSize.Small" Style="opacity: 0.75;">
        Envie um arquivo CSV com os clientes a serem importados. O processamento ocorre em segundo plano e os clientes aparecerão na lista aos poucos.
    </FluentLabel>

    <FluentAnchorButton Href="assets/template.csv" ForceLoad="true" download="template.csv" Appearance="ButtonAppearance.Subtle" IconStart="@TemplateIcon">
        Baixar modelo de importação (.csv)
    </FluentAnchorButton>

    <CustomerImportForm OnValidSubmit="SubmitAsync" OnCancel="CancelAsync" />
</FluentStack>

@code {
    private static readonly Icon TemplateIcon = new Size20.DocumentTable();

    [CascadingParameter]
    public IDialogInstance Instance { get; set; } = default!;

    private async Task SubmitAsync(CustomersImportScheme model) =>
        await Instance.CloseAsync(DialogResult.Ok(model));

    private async Task CancelAsync() =>
        await Instance.CancelAsync();
}

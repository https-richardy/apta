@switch (State)
{
    case { HasError: true }:
        <FluentMessageBar Intent="MessageBarIntent.Error">
            Não foi possível carregar os clientes, se o problema persistir, contate o suporte técnico.
        </FluentMessageBar>
        break;

    case { CurrentData: { } customers }:
        <CustomersTable Customers="customers.Items" />
        break;

    default:
        <CustomersSkeleton />
        break;
}

@code {
    [Parameter]
    public QueryState<Pagination<CustomerScheme>> State { get; set; } = default!;
}

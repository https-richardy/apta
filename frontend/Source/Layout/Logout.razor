@inject IDialogService DialogService
@inject AuthenticationService AuthenticationService
@inject JwtBearerAuthenticationStateProvider AuthenticationState

<FluentButton Appearance="ButtonAppearance.Transparent" IconOnly="true" IconStart="@SignOutIcon" Title="Sair" OnClick="HandleLogoutAsync" />

@code {
    private static readonly Icon SignOutIcon = new Size28.ArrowExit();

    private async Task HandleLogoutAsync()
    {
        var confirmation = await DialogService.ShowConfirmationAsync(
            message: "Tem certeza de que deseja encerrar a sua sessão? Você precisará autenticar-se novamente para voltar a acessar o sistema.",
            title: "Encerrar sessão",
            primaryButton: "Sair da conta",
            secondaryButton: "Cancelar"
        );

        if (confirmation.Cancelled)
        {
            return;
        }

        var refreshToken = await AuthenticationState.GetRefreshTokenAsync();
        if (string.IsNullOrEmpty(refreshToken))
        {
            return;
        }

        AuthenticationService.LogoutMutation.Execute(refreshToken);
    }
}

<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.Shared.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <Authorizing>
                <p>Verificando autenticação...</p>
            </Authorizing>
            <NotAuthorized Context="authentication">
                <UnauthorizedRouteView Authentication="authentication" />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>

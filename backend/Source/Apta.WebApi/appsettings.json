{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Upload": {
        "MaxRequestBodySizeInBytes": 33554432
    },
    "Settings": {
        "Authentication": {
            "Authority": "${Settings__Authentication__Authority}",
            "Audience": "${Settings__Authentication__Audience}"
        },
        "Database": {
            "ConnectionString": "${Settings__Database__ConnectionString}",
            "MaxRetryCount": 5,
            "MaxRetryDelay": 30
        },
        "Observability": {
            "SentryDsn": "${Settings__Observability__SentryDsn}",
            "SeqCollector": "${Settings__Observability__SeqCollector}"
        }
    }
}
